# PUBLIC: VITE_ values are embedded in the browser bundle at build time.
# Never put secrets or admin credentials here. Rebuild after every change.
# API origin (no /api suffix). Blank uses same origin; local dev uses Vite proxy.
VITE_API_URL=
VITE_PORTFOLIO_NAME=Hammad Zahoor
VITE_PORTFOLIO_ROLE=Full-Stack Developer
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_LOCATION=
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
VITE_TWITTER_URL=
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_WHATSAPP_URL=
VITE_UPWORK_URL=
VITE_FIVERR_URL=
# Blank hides the CV action. Local paths are case-sensitive.
VITE_CV_URL=/CV.pdf
# Optional public production origin for canonical URL and sitemap
VITE_SITE_URL=

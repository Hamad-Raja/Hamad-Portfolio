NODE_ENV=development
PORT=5000
MONGO_URI=
# At least 32 random characters, server-only
JWT_SECRET=
ADMIN_EMAIL=
# bcrypt cost 10?15; see AUTH-MIGRATION.md. Never store plaintext here.
ADMIN_PASSWORD_HASH=
# Exact origins, comma-separated. HTTPS required in production. No wildcard.
CLIENT_ORIGIN=http://localhost:5173
# Leave blank for direct hosting. Set only for your verified reverse-proxy topology.
TRUST_PROXY_HOPS=
